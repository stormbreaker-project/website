---
import Base from '../../layouts/Base.astro';
import DeviceCard from '../../components/DeviceCard.astro';
import { DEVICES, UPCOMING, isActive, byActiveThenNewest, deviceYear, type Device } from '../../data/devices';
import '../../styles/devices.css';

// Active devices are pinned to their own section up top; everything else is
// grouped by its last-maintained (end) year, newest year first.
const active = DEVICES.filter(isActive).sort(byActiveThenNewest);

const groups: Record<string, Device[]> = {};
for (const d of DEVICES.filter((d) => !isActive(d)).sort(byActiveThenNewest)) {
  (groups[deviceYear(d)] ??= []).push(d);
}
const years = Object.keys(groups).sort((a, b) => b.localeCompare(a));

const stats = [
  { n: DEVICES.length, l: 'devices' },
  { n: active.length, l: 'active' },
  { n: UPCOMING.length, l: 'in progress' },
];
---
<Base title="Devices · Team StormBreaker" description="Every device Team StormBreaker has built kernels for since October 2019.">
  <main>
    <section>
      <div class="wrap">
        <div class="section-head left" style="margin-bottom:26px">
          <span class="kicker">the fleet</span>
          <h2>Devices we've built for</h2>
          <p>Every phone StormBreaker has shipped a kernel for, from our first releases in October 2019 to today.</p>
          <a class="devices-charter-link" href="/devices/charter/">See how these are maintained → the Maintenance Charter</a>
        </div>

        <div class="devices-stats">
          {stats.map((s) => (<span class="dstat"><b>{s.n}</b> {s.l}</span>))}
          <span class="dstat dstat-since">since October 2019</span>
        </div>

        {UPCOMING.length > 0 && (
          <div class="device-year">
            <h3 class="device-year-label">In progress <span class="dyl-count">{UPCOMING.length}</span></h3>
            <div class="device-grid" data-stagger>
              {UPCOMING.map((d) => <DeviceCard device={d} />)}
            </div>
          </div>
        )}

        {active.length > 0 && (
          <div class="device-year">
            <h3 class="device-year-label">Active <span class="dyl-count">{active.length}</span></h3>
            <div class="device-grid" data-stagger>
              {active.map((d) => <DeviceCard device={d} />)}
            </div>
          </div>
        )}

        {years.map((y) => (
          <div class="device-year">
            <h3 class="device-year-label">{y} <span class="dyl-count">{groups[y].length}</span></h3>
            <div class="device-grid" data-stagger>
              {groups[y].map((d) => <DeviceCard device={d} />)}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Base>
