---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import '../../styles/news.css';

const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [featured, ...rest] = posts;
---
<Base title="News · Team StormBreaker" description="Latest news, releases and announcements from Team StormBreaker.">
  <main>
    <section>
      <div class="wrap">
        <div class="section-head left">
          <span class="kicker">newsroom</span>
          <h2>News &amp; releases</h2>
          <p>Kernel drops, project updates and announcements from Team StormBreaker.</p>
        </div>

        {posts.length === 0 ? (
          <p class="news-status">No news yet. Check back soon.</p>
        ) : (
          <Fragment>
            <NewsCard post={featured} featured={true} />
            {rest.length > 0 && (
              <div class="news-list">
                {rest.map((post) => <NewsCard post={post} />)}
              </div>
            )}
          </Fragment>
        )}
      </div>
    </section>
  </main>
</Base>
