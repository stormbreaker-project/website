---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SOCIAL } from '../config/site';
import '../styles/about.css';

const milestones = [
  { year: 'October 2019', title: 'The first spark', body: 'Team StormBreaker launches with our first batch of devices. A small group of enthusiasts building better kernels for the phones we actually carried.' },
  { year: 'Late 2019 to 2020', title: 'It caught fire', body: 'Our releases spread fast across Telegram communities and XDA, and StormBreaker quickly became a familiar name in the custom kernel scene, on its way to over a million downloads.' },
  { year: '2020 to 2021', title: 'A growing team', body: 'A handful of maintainers joined to bring StormBreaker to more and more devices, turning a side project into a real community effort.' },
  { year: '2021 to 2023', title: 'Deep under the hood', body: 'LTS merges, ACK merges, CLO merges, backports, upstream releases and Custom ROM integrations. The serious kernel work we became known for.' },
  { year: 'Along the way', title: 'StormBreaker Clang', body: 'We built our own optimized Clang toolchain to compile our kernels. It is on pause now, and one we intend to revive.' },
  { year: '2024 to today', title: 'The lull, and what comes next', body: 'As life pulled contributors in different directions, active development and community support slowed. Everything we built is still here, and we are rebuilding, starting with this new home.' },
];
---
<Base title="About · Team StormBreaker" description="The story of Team StormBreaker, a community building custom Android kernels since October 2019.">
  <main>
    <section>
      <div class="wrap">
        <div class="section-head">
          <span class="kicker">Our story</span>
          <h2>About Team StormBreaker</h2>
          <p>A volunteer community building custom Android kernels, in the open, since October 2019.</p>
        </div>

        <p class="about-lead">
          Team StormBreaker began in October 2019 as a small group of enthusiasts building better
          kernels for the phones we actually carried. What started with a handful of devices grew into
          a name known across XDA and the Telegram custom kernel scene, with over a million downloads,
          a team of device maintainers, and deep upstream work. Life eventually pulled contributors in
          different directions and things slowed down, but the sources, the community and the legacy
          are all still here.
        </p>

        <div class="timeline">
          {milestones.map((m) => (
            <div class="milestone">
              <div class="year">{m.year}</div>
              <h3>{m.title}</h3>
              <p>{m.body}</p>
            </div>
          ))}
        </div>

        <div class="about-cta">
          <a class="btn btn-primary" href={SOCIAL.github} target="_blank" rel="noopener">
            <Icon name="github" /> Explore our work on GitHub
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>
