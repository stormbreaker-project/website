---
import { SOCIAL } from '../config/site';
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap foot-inner">
    <a class="brand" href="/">
      <span class="mark"><img src="/logo.jpeg" alt="" width="32" height="32" /></span>
      <span class="brand-name">Team StormBreaker</span>
    </a>
    <div class="foot-links">
      <a href={SOCIAL.github} target="_blank" rel="noopener">GitHub</a>
      <a href={SOCIAL.twitter} target="_blank" rel="noopener">X / Twitter</a>
      <a href={SOCIAL.guidelines} target="_blank" rel="noopener">Guidelines</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </div>
    <div class="muted">© {year} Team StormBreaker · GPL-licensed · Made on Earth 🌍</div>
  </div>
</footer>
