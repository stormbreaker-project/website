---
import Icon from './Icon.astro';
import type { Kernel } from '../data/kernels';
export interface Props {
  kernel: Kernel;
}
const { kernel } = Astro.props;
const { codename, device, stars, chip, href, view = 'Source' } = kernel;
---
<a class="kernel reveal" href={href} target="_blank" rel="noopener">
  <div class="top">
    <span class="codename">{codename}</span>
    <span class="stars">
      {typeof stars === 'number' ? (<><Icon name="star" />{stars}</>) : stars}
    </span>
  </div>
  <div class="device">{device}</div>
  <div class="foot">
    <span class="chip">{chip}</span>
    <span class="view">{view} <Icon name="arrowUpRight" /></span>
  </div>
</a>
