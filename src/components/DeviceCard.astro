---
import type { Device } from '../data/devices';
export interface Props {
  device: Device;
}
const { device } = Astro.props;
const { name, codename, start, end, upcoming } = device;

const active = end === 'present';
const period = upcoming ? '' : active ? `${start} – present` : end ? `${start} – ${end}` : start;

// Link to the org repo search for this codename (avoids guessing exact slugs).
const term = codename.split(/[\s/]+/)[0];
const href = `https://github.com/stormbreaker-project?q=${encodeURIComponent(term)}&type=repositories`;
---
<a class="device-card reveal" href={href} target="_blank" rel="noopener">
  <div class="dc-top">
    <span class="codename">{codename}</span>
    {upcoming ? <span class="dc-wip">In progress</span> : active && <span class="dc-active">Active</span>}
  </div>
  <div class="dc-name">{name}</div>
  {period && <div class="dc-period">{period}</div>}
</a>
