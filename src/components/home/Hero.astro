---
import Icon from '../Icon.astro';
import { SOCIAL } from '../../config/site';
import { DEVICES } from '../../data/devices';

const stats = [
  { num: '1M+', lbl: 'Downloads' },
  { num: `${DEVICES.length}`, lbl: 'Devices' },
  { num: '7', lbl: 'Years' },
  { num: '57', lbl: 'Repositories' },
];
---
<section class="hero">
  <div class="wrap">
    <span class="eyebrow reveal"><span class="dot"></span> Custom Android Kernels · Since October 2019</span>
    <h1 class="reveal">Kernels forged in<br /><span class="grad">the storm.</span></h1>
    <p class="lead reveal">
      Since October 2019, Team StormBreaker has brought fast, clean custom Linux kernels to Android —
      over a million downloads across {DEVICES.length} devices, built in the open by a volunteer community.
    </p>
    <div class="hero-cta reveal">
      <a class="btn btn-primary" href="#devices">Explore devices <Icon name="arrowRight" /></a>
      <a class="btn btn-ghost" href={SOCIAL.github} target="_blank" rel="noopener">View on GitHub</a>
    </div>

    <div class="stats reveal">
      {stats.map((s) => (
        <div class="stat"><div class="num">{s.num}</div><div class="lbl">{s.lbl}</div></div>
      ))}
    </div>
  </div>
</section>
