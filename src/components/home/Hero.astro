---
import Icon from '../Icon.astro';
import { SOCIAL } from '../../config/site';

const stats = [
  { num: '30+', lbl: 'Devices' },
  { num: '57', lbl: 'Repositories' },
  { num: '6+', lbl: 'Years shipping' },
  { num: 'C · ARM64', lbl: 'Built on' },
];
---
<section class="hero">
  <div class="wrap">
    <span class="eyebrow reveal"><span class="dot"></span> Custom Android Kernels · Since 2019</span>
    <h1 class="reveal">Kernels forged in<br /><span class="grad">the storm.</span></h1>
    <p class="lead reveal">
      Team StormBreaker builds fast, clean and actively-maintained custom Linux kernels for Android
      devices — squeezing every bit of performance and battery out of the hardware you already own.
    </p>
    <div class="hero-cta reveal">
      <a class="btn btn-primary" href="#kernels">Explore kernels <Icon name="arrowRight" /></a>
      <a class="btn btn-ghost" href={SOCIAL.github} target="_blank" rel="noopener">View on GitHub</a>
    </div>

    <div class="stats reveal">
      {stats.map((s) => (
        <div class="stat"><div class="num">{s.num}</div><div class="lbl">{s.lbl}</div></div>
      ))}
    </div>
  </div>
</section>
