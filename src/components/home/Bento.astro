---
import { ROMS } from '../../data/roms';
import { DEVICES } from '../../data/devices';
import '../../styles/bento.css';

const active = DEVICES.filter((d) => d.end === 'present').length;

type Commit = { sha: string; repo: string; subject: string; date: string };

// Real, currently-maintained kernel trees. We pull their latest commits at
// build time, so `npm run build` always shows real, current work.
const REPOS = [
  'linux-xiaomi-gauguin',
  'linux-oneplus-billie',
  'linux-xiaomi-surya',
  'linux-realme-r5x',
  'linux-xiaomi-miatoll',
  'linux-realme-nemo',
];
const repoLabel = (r: string) => r.split('-').pop() as string;

// Snapshot of real commits — used only if the build-time fetch is offline or
// rate-limited, so the page never falls back to fake data.
const FALLBACK: Commit[] = [
  { sha: '1c7d9e8', repo: 'gauguin', subject: 'arm64/configs: gauguin: Update LOCALVERSION', date: '' },
  { sha: '80f1e5f', repo: 'surya', subject: 'UPSTREAM: tty: allow TIOCSLCKTRMIOS with CAP_CHECKPOINT_RESTORE', date: '' },
  { sha: '0b8a86c', repo: 'billie', subject: 'techpack/display: dsi: Demote unsupported serial message to debug', date: '' },
  { sha: '6af305d', repo: 'r5x', subject: 'msm: kgsl: Use kthread instead of workqueue for event work', date: '' },
  { sha: '5dec840', repo: 'nemo', subject: 'mm: Tweak memory pressure for 3/4GB RAM devices', date: '' },
  { sha: '9ba2d27', repo: 'miatoll', subject: 'arm64: generate dtb.img from dtbs', date: '' },
];

async function fetchRepo(repo: string): Promise<Commit[]> {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 4000);
  try {
    const res = await fetch(`https://api.github.com/repos/stormbreaker-project/${repo}/commits?per_page=10`, {
      headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'stormbreaker-site' },
      signal: ctrl.signal,
    });
    if (!res.ok) return [];
    const data = (await res.json()) as any[];
    const noise = /^(Merge|fixup!|squash!|Revert)\b/;
    return data
      .filter((c) => !noise.test(String(c.commit?.message ?? '')))
      .slice(0, 2)
      .map((c) => ({
        sha: String(c.sha).slice(0, 7),
        repo: repoLabel(repo),
        subject: String(c.commit.message).split('\n')[0],
        date: c.commit?.author?.date ?? '',
      }));
  } catch {
    return [];
  } finally {
    clearTimeout(timer);
  }
}

let commits: Commit[] = [];
try {
  const all = (await Promise.all(REPOS.map(fetchRepo))).flat();
  commits = all
    .sort((a, b) => (a.date < b.date ? 1 : -1))
    .slice(0, 6);
} catch {
  commits = [];
}
if (commits.length === 0) commits = FALLBACK;
---
<section class="pb">
  <div class="wrap">
    <div class="pb-grid">

      <div class="pb-cell pb-hero-cell">
        <span class="pb-tag">the point</span>
        <p class="pb-big">We upstream the garbage OEMs leave behind.</p>
        <p class="pb-sub">LTS, ACK, and CLO merges landed by hand. No stale blobs pretending to be a kernel.</p>
      </div>

      <div class="pb-cell pb-ink pb-log-cell">
        <div class="pb-log-head"><span class="pb-prompt">$</span> git log --oneline <span class="pb-log-note">// trees</span></div>
        {commits.map((c) => (
          <div class="pb-log-row"><span class="pb-hash">{c.sha}</span><span class="pb-msg">{c.subject}</span></div>
        ))}
      </div>

      <div class="pb-cell pb-stat-cell">
        <div class="pb-stat-num">{active}</div>
        <div class="pb-stat-lbl">devices we still ship for, today</div>
      </div>

      <div class="pb-cell pb-roms-cell">
        <span class="pb-tag">shipped as stock in</span>
        <div class="pb-roms">
          {ROMS.map((r) => (
            <a class="pb-rom" href={r.url} target="_blank" rel="noopener">
              {r.logo && <img src={r.logo} alt="" width="30" height="30" loading="lazy" />}
              <span>{r.name}</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
