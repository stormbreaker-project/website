---
import '../../styles/features.css';

// High-level "why" points. The first is the lead (spans full width); it's the
// thing that actually sets StormBreaker apart.
const features = [
  { title: 'Deep upstream work', body: 'We rebase the OEM kernel source onto the latest Linux-stable and land LTS, ACK, and CLO merges by hand, then pull features back from newer upstreams. This is the part most kernels skip.', lead: true },
  { title: 'Tuned for speed', body: 'Schedulers, governors and I/O tuned so everyday scrolling and gaming stay smooth, without trading away stability.' },
  { title: 'Backports', body: 'Modern features pulled back to the kernel your device actually runs, like BBR for networking and scheduler improvements from newer trees.' },
  { title: 'Battery friendly', body: 'Idle and thermal tuning that keeps drain in check, for better standby and cooler temperatures under load.' },
  { title: 'Fully open source', body: 'Every line lives on GitHub under the GPL. Clone it, audit it, build it, or send a pull request.' },
];

// Detailed, curated feature buckets (dated/risky items trimmed, CAF -> CLO).
const buckets = [
  { title: 'performance', items: [
    'BBR congestion control, backported from 4.14 to 4.4 LTS',
    'Scheduler tuning: schedutil and schedtune boost',
    'vDSO32 mapped for low-overhead userspace time calls',
    'srandom, an add-on module for a faster /dev/urandom',
    'Selected RCU and TCP updates from newer kernels',
    'Plenty more under-the-hood tuning',
  ]},
  { title: 'stability', items: [
    'Modern Clang compiler optimizations',
    'Bug fixes and security hardening',
    'LZ4-compressed zRAM',
    'Regular Linux-stable and CLO merges',
    'TTL fix and more',
  ]},
  { title: 'battery', items: [
    'Trimmed debug logging',
    'GPU power optimizations',
    'Idle wakelock tuning',
    'Display panel power tuning',
    'Scheduler tuning for efficiency',
    'System-wide power-efficient workqueues',
  ]},
];
---
<section id="features">
  <div class="wrap">
    <div class="section-head left reveal">
      <span class="kicker">why stormbreaker</span>
      <h2>Built to perform, made to last</h2>
      <p>Real engineering, tracked upstream and built for balance. Official and unofficial ROMs have shipped StormBreaker as their stock kernel.</p>
    </div>

    <div class="feature-grid" data-stagger>
      {features.map((f, i) => (
        <div class={`feature reveal${f.lead ? ' feature-lead' : ''}`}>
          <span class="f-idx">{String(i + 1).padStart(2, '0')}</span>
          <div class="f-body"><h3>{f.title}</h3><p>{f.body}</p></div>
        </div>
      ))}
    </div>

    <div class="hood-head reveal">
      <span class="kicker">under the hood</span>
      <p>Stability first. We don't ship tweaks that trade it away for a benchmark number.</p>
    </div>

    <div class="hood reveal">
      <div class="hood-bar">
        <span></span><span></span><span></span>
      </div>
      <div class="hood-body">
        {buckets.map((b) => (
          <div class="hood-col">
            <div class="hood-h"># {b.title}</div>
            {b.items.map((i) => (
              <div class="hood-line"><span class="hood-plus">+</span>{i}</div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
