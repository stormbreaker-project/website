---
import '../../styles/features.css';

// High-level "why" cards.
const features = [
  { title: 'Tuned for speed', body: 'Carefully tuned schedulers, governors and I/O that keep everyday scrolling and gaming smooth without giving up stability.' },
  { title: 'Deep upstream work', body: 'Upstreaming the OEM kernel source onto the latest Linux-stable, with regular LTS, ACK and CLO merges and features ported from newer upstreams.' },
  { title: 'Backports', body: 'Useful features pulled back from newer kernels to the version your device runs, like RCU for faster file operations and BBR for networking.' },
  { title: 'Battery friendly', body: 'Idle and thermal tuning that keeps drain in check, for better standby and cooler temperatures under load.' },
  { title: 'Fully open source', body: 'Every line lives on GitHub under the GPL. Clone it, audit it, build it, or send a pull request.' },
];

// Detailed, curated feature buckets (dated/risky items trimmed, CAF -> CLO).
const buckets = [
  { title: 'performance', items: [
    'RCU backports for faster file operations',
    'Schedtune boost for snappier interaction',
    'BBR congestion control, backported 4.14 to 4.4 LTS',
    'TCP stack backports for throughput and latency',
    'vDSO32 for low-overhead userspace time calls',
    'srandom for a faster /dev/urandom',
    'Plenty more under-the-hood tuning',
  ]},
  { title: 'stability', items: [
    'Modern Clang compiler optimizations',
    'Bug fixes and security hardening',
    'LZ4-compressed zRAM',
    'Regular Linux-stable and CLO merges',
    'TTL fix and more',
  ]},
  { title: 'battery', items: [
    'Trimmed debug logging',
    'GPU power optimizations',
    'Idle wakelock tuning',
    'Display panel power tuning',
    'Scheduler tuning for efficiency',
    'System-wide power-efficient workqueues',
  ]},
];
---
<section id="features">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="kicker">why stormbreaker</span>
      <h2>Built to perform, made to last</h2>
      <p>Real engineering, tracked upstream and built for balance. Official and unofficial ROMs have shipped StormBreaker as their stock kernel.</p>
    </div>

    <div class="feature-grid">
      {features.map((f, i) => (
        <div class="feature reveal">
          <span class="f-idx">{String(i + 1).padStart(2, '0')}</span>
          <div class="f-body"><h3>{f.title}</h3><p>{f.body}</p></div>
        </div>
      ))}
    </div>

    <div class="lists-head reveal">
      <h3>Under the hood</h3>
      <p>Stability first. We don't ship tweaks that trade it away for a benchmark number.</p>
    </div>

    <div class="feature-lists">
      {buckets.map((b) => (
        <div class="flist reveal">
          <h3><span class="flist-slash">//</span> {b.title}</h3>
          <ul>{b.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>
