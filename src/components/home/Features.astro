---
import '../../styles/features.css';

// Decorative, page-specific icons kept inline here.
const features = [
  { title: 'Tuned for speed', body: 'Aggressive-yet-stable schedulers, governors and I/O tuning that make everyday scrolling and gaming noticeably smoother.', icon: '<path d="M13 2 4 14h6l-1 8 9-12h-6z"/>' },
  { title: 'Upstream-tracked', body: 'Regularly rebased on Linux-stable and CAF/mainline, so security patches and fixes land fast — including fresh mainline device ports.', icon: '<path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/>' },
  { title: 'Battery-friendly', body: 'Idle and thermal tuning that keeps drain in check without throttling the fun — better standby, cooler under load.', icon: '<path d="M9 12l2 2 4-4"/><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/>' },
  { title: 'Fully open source', body: "Every line is on GitHub under GPL. Clone it, audit it, build it, send a PR — that's the whole point.", icon: '<path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/>' },
];
---
<section id="features">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="kicker">Why StormBreaker</span>
      <h2>Built to perform, made to last</h2>
      <p>Not just another overclock. Real engineering, tracked upstream and maintained in the open.</p>
    </div>

    <div class="feature-grid">
      {features.map((f) => (
        <div class="feature reveal">
          <div class="ico"><svg viewBox="0 0 24 24" set:html={f.icon}></svg></div>
          <div><h3>{f.title}</h3><p>{f.body}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>
