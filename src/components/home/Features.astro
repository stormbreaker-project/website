---
import '../../styles/features.css';

// Decorative, page-specific icons kept inline here.
const features = [
  { title: 'Tuned for speed', body: 'Carefully tuned schedulers, governors and I/O that keep everyday scrolling and gaming smooth without giving up stability.', icon: '<path d="M13 2 4 14h6l-1 8 9-12h-6z"/>' },
  { title: 'Deep upstream work', body: 'Regular LTS, ACK and CLO merges keep the kernel current, secure and close to what Google and Qualcomm ship.', icon: '<path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/>' },
  { title: 'Backports', body: 'Useful fixes and features from newer kernels, carefully pulled back to the version your device actually runs.', icon: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>' },
  { title: 'Battery friendly', body: 'Idle and thermal tuning that keeps drain in check, for better standby and cooler temperatures under load.', icon: '<rect x="2" y="8" width="16" height="9" rx="2"/><path d="M22 11v3M6 11v3M9 11v3"/>' },
  { title: 'Fully open source', body: 'Every line lives on GitHub under the GPL. Clone it, audit it, build it, or send a pull request.', icon: '<path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/>' },
];
---
<section id="features">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="kicker">Why StormBreaker</span>
      <h2>Built to perform, made to last</h2>
      <p>Not just another overclock. Real engineering, tracked upstream and maintained in the open.</p>
    </div>

    <div class="feature-grid">
      {features.map((f) => (
        <div class="feature reveal">
          <div class="ico"><svg viewBox="0 0 24 24" set:html={f.icon}></svg></div>
          <div><h3>{f.title}</h3><p>{f.body}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>
