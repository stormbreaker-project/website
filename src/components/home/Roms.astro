---
import { ROMS } from '../../data/roms';
import '../../styles/roms.css';
---
<section id="roms">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="kicker">Ecosystem</span>
      <h2>Powering your favourite ROMs</h2>
      <p>Official and unofficial builds of these ROMs ship StormBreaker as their kernel.</p>
    </div>

    <div class="rom-grid reveal">
      {ROMS.map((r) =>
        r.url ? (
          <a class="rom" href={r.url} target="_blank" rel="noopener">
            {r.logo && <img class="rom-logo" src={r.logo} alt="" width="48" height="48" loading="lazy" />}
            <span class="rom-name">{r.name}</span>
          </a>
        ) : (
          <span class="rom">
            {r.logo && <img class="rom-logo" src={r.logo} alt="" width="48" height="48" loading="lazy" />}
            <span class="rom-name">{r.name}</span>
          </span>
        ),
      )}
    </div>
  </div>
</section>
