---
import Icon from '../Icon.astro';
import { SOCIAL } from '../../config/site';
import '../../styles/community.css';
---
<section id="community">
  <div class="wrap">
    <div class="cta-panel reveal">
      <span class="cta-kicker">// join the team</span>
      <h2>Come build with us.</h2>
      <p>Maintainers, testers, and the curious are all welcome. Report a bug, request a device, or ship your first commit.</p>

      <div class="cta-actions">
        <a class="btn cta-btn" href={SOCIAL.github} target="_blank" rel="noopener">
          <Icon name="github" /> Start on GitHub
        </a>
        <div class="cta-links">
          <a href={SOCIAL.telegram} target="_blank" rel="noopener">Telegram</a>
          <a href={SOCIAL.discord} target="_blank" rel="noopener">Discord</a>
          <a href={SOCIAL.twitter} target="_blank" rel="noopener">@StormBreakerOSS</a>
          <a href={`mailto:${SOCIAL.email}`}>Email</a>
        </div>
      </div>
    </div>
  </div>
</section>
