---
import KernelCard from '../KernelCard.astro';
import { KERNELS } from '../../data/kernels';
import '../../styles/kernels.css';
---
<section id="kernels">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="kicker">Featured builds</span>
      <h2>Kernels people actually flash</h2>
      <p>Unified sources, upstream-tracked and tuned per device. Pick your codename and go.</p>
    </div>

    <div class="kernel-grid">
      {KERNELS.map((kernel) => <KernelCard kernel={kernel} />)}
    </div>
  </div>
</section>
