---
import DeviceCard from '../DeviceCard.astro';
import { DEVICES, byActiveThenNewest } from '../../data/devices';
import '../../styles/devices.css';

const featured = DEVICES.filter((d) => d.featured).sort(byActiveThenNewest);
---
<section id="devices">
  <div class="wrap">
    <div class="section-head left reveal">
      <span class="kicker">featured builds</span>
      <h2>Devices we've built for</h2>
      <p>A handful of the phones we've shipped kernels for over the years, from our first releases to the ones still going.</p>
    </div>

    <div class="device-grid" data-stagger>
      {featured.map((d) => <DeviceCard device={d} />)}
    </div>

    <div class="devices-cta reveal">
      <a class="btn btn-ghost" href="/devices/">View all {DEVICES.length} devices →</a>
    </div>
  </div>
</section>
