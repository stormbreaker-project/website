---
import Icon from '../Icon.astro';
import { SOCIAL } from '../../config/site';
import { DEVICES } from '../../data/devices';
import '../../styles/hero.css';

// The numbers worth bragging about — surfaced as feats, not a stats dump.
// Each rolls up from 0 on scroll-in (see the script below); the final value is
// server-rendered so no-JS / reduced-motion visitors still see the real number.
type Feat = { to: number; kind: 'compact' | 'int'; suffix: string; l: string };
const feats: Feat[] = [
  { to: 1_000_000, kind: 'compact', suffix: '+', l: 'downloads served' },
  { to: DEVICES.length, kind: 'int', suffix: '', l: 'devices maintained' },
  { to: 7, kind: 'int', suffix: ' yrs', l: 'in the open, since 2019' },
];
const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
const fmt = (f: Feat, v: number) => (f.kind === 'compact' ? compact.format(v) : String(Math.round(v))) + f.suffix;

// Ghosted boot log that bleeds behind the hero.
const boot = [
  '[    0.000000] Booting Linux on physical CPU 0x0000000000',
  '[    0.000000] Linux version 4.19.325-StormBreaker (clang 18)',
  '[    0.000000] Machine model: your phone, three years newer',
  '[    0.451021] tcp: BBR congestion control backported from 4.14',
  '[    1.882204] rcu: hierarchical RCU backport online',
  '[    2.104882] random: srandom fast entropy source registered',
  '[    2.318740] vdso: vDSO32 mapped, userspace time goes brrr',
  '[    2.451021] StormBreaker: forged in the storm.',
];
---
<section class="ph">
  <pre class="ph-boot" aria-hidden="true">{boot.join('\n')}</pre>

  <div class="wrap ph-inner">
    <span class="ph-eyebrow">// custom android kernels · since oct 2019</span>

    <h1 class="ph-h1">Kernels forged in<br /><span class="ph-mark">the storm.</span></h1>

    <p class="ph-lead">
      OEMs freeze their kernels at launch and never look back. We drag them forward with LTS bumps,
      CLO merges, and real backports, so your phone runs like the code was written this year instead
      of three years ago.
    </p>

    <div class="ph-cta">
      <a class="ph-btn ph-btn-solid" href="#devices">Explore devices <Icon name="arrowRight" /></a>
      <a class="ph-btn ph-btn-line" href={SOCIAL.github} target="_blank" rel="noopener">View GitHub</a>
    </div>

    <div class="ph-feats">
      {feats.map((f) => (
        <div class="ph-feat">
          <div class="ph-feat-n" data-to={f.to} data-kind={f.kind} data-suffix={f.suffix}>{fmt(f, f.to)}</div>
          <div class="ph-feat-l">{f.l}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Roll the feat numbers up from 0 when they scroll into view.
  const nums = Array.from(document.querySelectorAll<HTMLElement>('.ph-feat-n[data-to]'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });

  const paint = (el: HTMLElement, v: number) => {
    const suffix = el.dataset.suffix ?? '';
    el.textContent = (el.dataset.kind === 'compact' ? compact.format(v) : String(Math.round(v))) + suffix;
  };

  const roll = (el: HTMLElement) => {
    const to = Number(el.dataset.to);
    const dur = 1400;
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    let start: number | null = null;
    const step = (ts: number) => {
      if (start === null) start = ts;
      const p = Math.min(1, (ts - start) / dur);
      paint(el, to * ease(p));
      if (p < 1) requestAnimationFrame(step);
      else paint(el, to);
    };
    requestAnimationFrame(step);
  };

  if (!reduce && 'IntersectionObserver' in window && nums.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            roll(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.6 },
    );
    nums.forEach((el) => {
      paint(el, 0); // reset before rolling
      io.observe(el);
    });
  }
</script>
